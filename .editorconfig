root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Biome: indentStyle = tab, quoteStyle = double
[*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,json5,css,html}]
indent_style = tab
indent_size = 2

# Black / Ruff: 4 spaces, line-length = 120
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# Buildifier: 4 spaces
[*.{bzl,bazel,mirror}]
indent_style = space
indent_size = 4

[{BUILD,WORKSPACE,MODULE.bazel,REPO.bazel}]
indent_style = space
indent_size = 4

# YAML: 2 spaces
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# Markdown: 2 spaces, preserve trailing whitespace (line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Terraform / OpenTofu: 2 spaces
[*.{tf,tofu,tfvars,tofuvars}]
indent_style = space
indent_size = 2

# Shell: 2 spaces
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# TOML: 2 spaces
[*.toml]
indent_style = space
indent_size = 2

# Windows batch files: CRLF (per .gitattributes)
[*.{bat,cmd}]
end_of_line = crlf
