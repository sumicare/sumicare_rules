	"scripts": {
		"fix": "run-s fix:*",
		"fix:bazel": "buildifier -r .",
		"fix:python": "run-p fix:python:*",
		"fix:python:ruff": "ruff check --fix packages/services/sumicare_agents",
		"fix:python:black": "black packages/services/sumicare_agents",
		"fix:python:deps": "uv lock --upgrade --directory packages/services/sumicare_agents",
		"fix:node": "run-p fix:node:*",
		"fix:node:biome": "biome check --write",
		"fix:node:deps": "taze -r --write",
		"fix:node:sync": "tsx scripts/sync-workspace-deps.mts",
		"fix:node:audit": "pnpm audit --fix=override",
		"fix:spellcheck": "tsx scripts/spellcheck.mts --exclude",
		"fix:scan": "tsx scripts/scan.mts",
		"prepare": "husky",
		"build": "turbo run build --ui tui",
		"test": "rstest",
		"test:update": "rstest -u",
		"test:coverage": "rstest --coverage",
		"clean": "run-p clean:*",
		"clean:dist": "pnpm -r exec rimraf dist",
		"clean:coverage": "pnpm -r exec rimraf .coverage",
		"clean:cache": "pnpm -r exec rimraf node_modules/.cache",
		"clean:imports": "pnpm -r exec rimraf imports",
		"clean:crds": "pnpm -r exec rimraf crds",
		"clean:cdktf": "run-p clean:cdktf:*",
		"clean:cdktf:root": "rimraf cdktf.out",
		"clean:cdktf:packages": "pnpm -r exec rimraf cdktf.out",
		"clean:ruff": "run-p clean:ruff:*",
		"clean:ruff:root": "rimraf .ruff_cache",
		"clean:ruff:packages": "pnpm -r exec rimraf .ruff_cache",
		"clean:turbo": "run-p clean:turbo:*",
		"clean:turbo:root": "rimraf .turbo",
		"clean:turbo:packages": "pnpm -r exec rimraf .turbo",
		"watch": "turbo run watch"
	},
